  - m_Id: 497
    m_Localized: Vi phạm giao thức
    m_Metadata:
      m_Items: []
  - m_Id: 498
    m_Localized: Nhà cung cấp đã được liên kết
    m_Metadata:
      m_Items: []
  - m_Id: 499
    m_Localized: 'Thao tác quá nhanh, vui lòng thử lại sau'
    m_Metadata:
      m_Items: []
  - m_Id: 500
    m_Localized: Phiên khôi phục đã hết hạn
    m_Metadata:
      m_Items: []
  - m_Id: 501
    m_Localized: Không thể thao tác với cùng tài khoản
    m_Metadata:
      m_Items: []
  - m_Id: 502
    m_Localized: Máy chủ đang bảo trì
    m_Metadata:
      m_Items: []
  - m_Id: 503
    m_Localized: Máy chủ quá tải
    m_Metadata:
      m_Items: []
  - m_Id: 504
    m_Localized: 'Phiên đã lỗi thời, vui lòng đồng bộ lại'
    m_Metadata:
      m_Items: []
  - m_Id: 505
    m_Localized: Phiên bị thay thế bởi đăng nhập khác
    m_Metadata:
      m_Items: []
  - m_Id: 506
    m_Localized: Bộ kỹ năng không hợp lệ
    m_Metadata:
      m_Items: []
  - m_Id: 507
    m_Localized: Kỹ năng đã đạt cấp tối đa
    m_Metadata:
      m_Items: []
  - m_Id: 508
    m_Localized: Chưa học kỹ năng
    m_Metadata:
      m_Items: []
  - m_Id: 509
    m_Localized: Không đủ điểm kỹ năng
    m_Metadata:
      m_Items: []
  - m_Id: 510
    m_Localized: Ô trống
    m_Metadata:
      m_Items: []
  - m_Id: 511
    m_Localized: Ô không khớp
    m_Metadata:
      m_Items: []
  - m_Id: 512
    m_Localized: Đã đạt giới hạn khế ước Hồn
    m_Metadata:
      m_Items: []
  - m_Id: 513
    m_Localized: Dữ liệu đầu vào đã lỗi thời
    m_Metadata:
      m_Items: []
  - m_Id: 514
    m_Localized: Trạng thái xung đột
    m_Metadata:
      m_Items: []
  - m_Id: 515
    m_Localized: Cần chọn hướng cốt truyện
    m_Metadata:
      m_Items: []
  - m_Id: 516
    m_Localized: Mục tiêu bị chặn
    m_Metadata:
      m_Items: []
  - m_Id: 517
    m_Localized: Mục tiêu không hợp lệ
    m_Metadata:
      m_Items: []
  - m_Id: 518
    m_Localized: Dịch vụ tạm thời gián đoạn
    m_Metadata:
      m_Items: []
  - m_Id: 519
    m_Localized: Chỉ một bên được đưa tiền thường
    m_Metadata:
      m_Items: []
  - m_Id: 520
    m_Localized: Tài khoản chưa đủ tuổi để giao dịch
