%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Core_vi-VN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: 8dea249fe91e5b1e48cd643a89859f3f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1
    m_Localized: Bóng nước ma mị
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: Cá tinh hóa người
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: 'Theo lời kể dân gian, cá tinh già đã ẩn bao năm dưới bùn; đi chậm nhưng dòng nước sau lưng nó thì không thể chạy thoát'
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Hồn chết đuối oan khuất
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: Ma da kéo giò bến nước đen
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: Ma da già giữ bến
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: 'Theo lời kể dân gian, người sông cổ là hồn xưa nằm lại dưới đáy bùn từ thời loạn lạc; vẫn bắn hai tên một lúc như thuở chiến trận'
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: 'Theo lời kể dân gian, quỷ sông đêm ẩn dưới bùn đen, dụ đèn lên rồi kéo người xuống'
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: 'Theo lời kể dân gian, thuồng luồng sông là loài thủy quái nhỏ lang thang theo dòng nước, khác với chúa tể đã thành tinh ở vùng sâu'
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Thủy quái bến đen
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Hổ con tinh nghịch
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: 'Theo lời kể dân gian, hổ tinh đèo mây là hổ rừng đã luyện phép nhỏ; khác với chúa tinh chin đuôi đã thành tướng'
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: 'Theo lời kể dân gian, hổ tinh lớn đèo mây đã tích đủ khí để cào xé bất kỳ ai rời con đường mòn'
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Hổ tinh vệ canh núi
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Khỉ núi tinh ranh
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Ma trành đèo mây
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Ma trành già đèo mây
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: 'Theo lời kể dân gian, ma vân đêm là bóng mây tụ lại thành hình sau nửa đêm; tiếng nổ của nó là điềm báo giông tố'
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: 'Theo lời kể dân gian, vong núi già là bóng ma núi lâu năm; vùng nguy hiểm của nó rộng dần như sương buổi sáng'
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Vong rừng sương mù
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: Bù nhìn canh đồng lúa đêm trăng
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: Cóc cụ bên miếu Đình
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Đom đóm ma lập lòe chỗ bến Đình Làng
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: 'Theo lời kể dân gian, hồn đo trăng lang thang dưới trăng khuya, dùng bóng làm tấm che che mặt'
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: 'Theo lời kể dân gian, hồn ma cổ thụ là linh hồn gắn vào cây già trăm năm; tán lá che khuất bao điều'
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: 'Theo lời kể dân gian, hồn xó nón giữ đường ranh làng; ai vô tình phá cột mốc sẽ bị ngăn lại'
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Ma xó giữ nhà
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: 'Theo lời kể dân gian, quỷ nhập tràng là hồn lạc nhập vào xác đêm sương, chưa đủ mạnh để thành tướng đầu sỏ'
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Vong lang thang bờ tre
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: 'Theo lời kể dân gian, vong hồn già là những linh hồn lâu năm không siêu thoát, chập chờn theo ánh đèn dầu'
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: 'Theo lời kể dân gian, bóng vong núi thiêng là bóng tối hút sinh lực của người đi lạc; khi nó nắm được người, một phần sức mạnh của nạn nhân biến thành lớp che chở tạm thời cho nó'
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: 'Theo lời kể dân gian, đại vong linh núi thiêng là những bóng ma lớn đã học được phép đổi hướng lúc chạy nước rút'
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: 'Theo lời kể dân gian, hồn binh cổ núi thiêng là linh hồn lính từ buổi đầu dựng cổng núi; nhát chém quét ngang của nó vẫn đủ lực sau bao thế kỷ canh gác một mình'
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: 'Theo lời kể dân gian, linh vệ núi thiêng là bộ giáp cũ của người canh cổng núi đã thành tinh; nó giữ thế thủ rồi phản đòn theo kiểu riêng, khác với thạch vệ thành cổ dùng thân đỡ'
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: 'Theo lời kể dân gian, ma núi sương phủ là bóng người chết vì lạc đường trên núi; nó đánh dấu vùng đất nguy hiểm trước khi hiện ra, nhắc lại lời cảnh báo của những cột mốc ranh giới cũ'
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: 'Theo lời kể dân gian, ngư tinh núi thiêng là cá lạ bơi trong hồ trên cao; khác với đại vương đã hóa thành tướng tinh dưới vực sâu'
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: 'Theo lời kể dân gian, thần rừng đêm núi thiêng là bóng tối tụ hình sau hoàng hôn; chạy trốn nó theo vết mờ trên đất mà nó để lại trước khi lao tới'
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: 'Theo lời kể dân gian, thần trùng đồng là loài linh trùng nhỏ sống trong vùng đất thiêng; khác với thủ lĩnh đội lốt đã tích đủ khí để thống lĩnh'
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: 'Theo lời kể dân gian, tinh núi già núi thiêng ẩn dưới đám mây mù; vùng nguy hiểm của nó xuất hiện khi người dám đứng bên bờ vực'
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: 'Theo lời kể dân gian, tinh thú núi thiêng là thú rừng già đã hấp thụ linh khí từ các đá ranh; viên đạn lửa nó phun ra sáng rõ trước khi rời miệng, như điềm báo mỗi khi núi nổi giận'
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: 'Theo lời kể dân gian, vong linh núi thiêng là linh hồn kẻ chết trên đường hành hương chưa dứt được; nó dịch chỗ rất nhanh nhưng luôn để lại bóng báo trước hướng di chuyển'
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Bóng người chập chờn
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: 'Theo lời kể dân gian, đại tinh cây là cổ thụ trăm tuổi đã thành tinh; rễ nó kéo lại những ai dám chặt cành'
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: Đóm lửa rừng thiêng
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Tiếng hú trong rừng U Minh
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Ma trành dắt lối
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Mộc tinh canh rừng
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Cây cổ thụ thành tinh
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: 'Theo lời kể dân gian, vong rừng sâu dẫn lối người lạ đi vòng mãi không ra; hai con đường nó vẽ chỉ một là thật'
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: 'Theo lời kể dân gian, hồn binh thành cổ vẫn tuần tra theo khu vực đặt lính ngày trước; giáo mác vô hình nhưng nhát chém từ nó để lại dấu vết thật'
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: 'Theo lời kể dân gian, hồn trận linh là linh hồn tướng lĩnh cũ vẫn giữ thế trận, nhát chém từ trên xuống rõ nét như thuở sinh thời'
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: 'Theo lời kể dân gian, hồn tướng giữ thành là vị tướng chưa chịu rời vị trí; bóng phân thân nó dẫn lính ảo theo sau, như những ngày còn chỉ huy đồn thành'
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: 'Theo lời kể dân gian, ma cổ thành hoang là bóng của kẻ chết không toàn thây trong trận chiến; nó đánh dấu đất trước khi xuất hiện, như lời cảnh báo duy nhất trước khi sập bẫy'
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: 'Theo lời kể dân gian, oan hồn đêm thành cổ là linh hồn lính chết oan không ai thờ cúng; chữ nguyền khắc lên người bị nó chạm'
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: 'Theo lời kể dân gian, quạ tinh canh thành là linh hồn sứ giả cũ đã hóa vào đàn quạ; tên bắn của nó bay lệch theo vòm đá như thuở chuyển thư hiệu lệnh qua pháo đài'
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: 'Theo lời kể dân gian, quạ tinh lớn thành cổ đã tích đủ năm tháng để bắn hai tên lệch hướng theo vòm đá'
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: 'Theo lời kể dân gian, thạch vệ là phiến đá cổng thành đã hóa linh sau nghìn năm canh gác; nó dùng thân làm mộc đỡ rồi phản công — không bao giờ tấn công kẻ đứng im'
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: 'Theo lời kể dân gian, tượng đá thành cổ là hồn lính chết nơi đồn trú không ai thờ cúng; đá hóa hình người khi đêm xuống — chậm chạp nhưng không thể xuyên qua được'
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: 'Theo lời kể dân gian, búp lửa đồng là bông lửa nhỏ bay trên ruộng lúa đêm hè; có người nói nó là khí đất tích tụ, có người nói là hồn lúa chưa gặt kịp trước mưa lũ'
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: 'Theo lời kể dân gian, cô lúa già là bù nhìn đứng canh đồng từ nhiều mùa gặt; bao nhiêu hồn lúa thấm vào cọc tre cũ đã làm nó cử động vào đêm khuya, dù không ai thấy nó nhúc nhích khi trời sáng'
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: 'Theo lời kể dân gian, đom đóm nguyên sơ là linh hồn nhỏ đầu tiên xuất hiện ở bến Đình Làng khi trời chưa sáng; khác với đom đóm ma thường gặp, nó chỉ xuất hiện đúng dịp và không ai biết từ đâu đến'
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: 'Theo lời kể dân gian, hồn gạo gò mả là linh hồn gắn vào những nắm gạo cúng để lâu không ai thu; đêm khuya nó lang thang theo bờ tre, tìm lại chỗ cũ như còn nhớ ơn người thờ cúng'
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: 'Theo lời kể dân gian, tinh bưởi đồng làng là hồn cây bưởi trồng ven ruộng đã thành tinh nhỏ; khác với các tinh cây to lớn trong rừng sâu, nó chỉ bảo vệ mảnh vườn mà nó đã gắn bó từ lúc còn là hạt giống'
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: 'Theo lời kể dân gian, vong biến bến đa là bóng người đã qua đò nhưng chưa đến nơi; nó lặp lại con đường mình quen, không biết mình đã không còn là người sống'
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: Gà Lửa
    m_Metadata:
      m_Items: []
